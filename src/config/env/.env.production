# Committed defaults for production. NO SECRETS IN THIS FILE — ever.
# DATABASE_URL, REDIS_URL, JWT_*, S3_*, WEBHOOK_HMAC_SECRET and SENTRY_DSN are
# injected by the secret manager. The config validator refuses to boot if any
# of them still holds a placeholder value.

APP_ENV=production
NODE_ENV=production

API_PORT=3000
API_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1

DATABASE_POOL_SIZE=20
DATABASE_LOG_QUERIES=false

TRUST_PROXY=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

WORKER_CONCURRENCY=10
RENDER_CONCURRENCY=2

LOG_LEVEL=info
LOG_PRETTY=false
SENTRY_TRACES_SAMPLE_RATE=0.1

# All three are enforced as false in production by validation.schema.ts.
SWAGGER_ENABLED=false
FEATURE_ROLE_SWITCHER=false
FEATURE_MOCK_INTEGRATIONS=false
