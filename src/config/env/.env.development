# Committed defaults for local/development. NO SECRETS IN THIS FILE.
# Secrets belong in the git-ignored root .env (local) or the secret manager.

APP_ENV=development
NODE_ENV=development

API_PORT=3000
API_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1

DATABASE_POOL_SIZE=10
DATABASE_LOG_QUERIES=false

MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM_ADDRESS=no-reply@ticketit.local
MAIL_FROM_NAME=Ticket-IT Portal

WORKER_CONCURRENCY=5
RENDER_CONCURRENCY=2

LOG_LEVEL=debug
LOG_PRETTY=true

SWAGGER_ENABLED=true
FEATURE_ROLE_SWITCHER=true
FEATURE_MOCK_INTEGRATIONS=true
