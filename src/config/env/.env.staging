# Committed defaults for staging. NO SECRETS IN THIS FILE.
# DATABASE_URL, REDIS_URL, JWT_* and S3_* come from the secret manager.

APP_ENV=staging
NODE_ENV=production

API_PORT=3000
API_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1

DATABASE_POOL_SIZE=15
DATABASE_LOG_QUERIES=false

TRUST_PROXY=true
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

WORKER_CONCURRENCY=5
RENDER_CONCURRENCY=2

LOG_LEVEL=info
LOG_PRETTY=false
SENTRY_TRACES_SAMPLE_RATE=0.25

# Staging mirrors production behaviour but keeps the API contract browsable
# for the frontend team.
SWAGGER_ENABLED=true
FEATURE_ROLE_SWITCHER=false
FEATURE_MOCK_INTEGRATIONS=true
