# ==========================================================================
# Ticket-IT Portal — environment template
#
#   cp .env.example .env
#
# This file is for LOCAL SECRETS and machine-specific overrides. Non-secret
# per-environment defaults are committed in src/config/env/.env.<APP_ENV>.
#
# Load order (first value wins):
#   process env  >  .env.local  >  .env  >  src/config/env/.env.<APP_ENV>
#
# Never commit .env. Deployed environments get their secrets from the secret
# manager; the config validator refuses to boot on a leftover placeholder.
# ==========================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_ENV=development               # development | staging | production
APP_NAME=ticketit-portal
API_PORT=3000
API_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1
SHUTDOWN_TIMEOUT_MS=15000
# Public address of the Next.js frontend. Every emailed link (invitation,
# password reset) is built against it, so it must be reachable by the
# *recipient*, not by this API.
PORTAL_BASE_URL=http://localhost:3001

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL=postgresql://ticketit:ticketit@localhost:55432/ticketit?schema=public
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOG_QUERIES=false

# --- Legacy database (Azure SQL Server) — READ-ONLY ------------------------
# Source of truth for first-time authentication only. The application never
# writes here; see src/database/legacy/read-only.extension.ts. Grant this login
# db_datareader and nothing more.
LEGACY_DATABASE_URL=sqlserver://HOST:1433;database=DBNAME;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=false;connectionTimeout=30
LEGACY_DATABASE_POOL_SIZE=5
# Re-check legacy when a user's local password hash fails to verify. Covers the
# case where the password was changed in the legacy system after we replicated
# it. Turning this off makes an upstream password change lock the user out.
LEGACY_AUTH_FALLBACK_ENABLED=true
# How long a replicated user is trusted before the next successful login also
# refreshes their profile from legacy (roles, deactivation, org fields).
LEGACY_USER_SYNC_TTL_SECONDS=86400

# --- Redis (cache + BullMQ) ------------------------------------------------
REDIS_URL=redis://localhost:6379
# How long a reporting aggregate stays cached. Zero disables the cache
# entirely, which is what the test suite runs with — nothing transactional is
# ever cached, so switching it off changes speed and not answers.
CACHE_TTL_SECONDS=60

REDIS_KEY_PREFIX=ticketit
QUEUE_PREFIX=ticketit

# --- Object storage (S3 / MinIO locally) -----------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ticketit-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true          # true for MinIO, false for real AWS S3
S3_PUBLIC_BASE_URL=http://localhost:9000/ticketit-assets
S3_PRESIGN_EXPIRY_SECONDS=900

# --- Document library (DAM) ------------------------------------------------
# Off until the DAM's endpoint and credentials exist. The switch is separate
# from the credentials on purpose: a half-configured library refuses loudly
# rather than half-working, and turning it off for an afternoon should not mean
# deleting a secret.
#
# With DAM_ENABLED=false every DAM route answers 503 with a message naming what
# is missing. Set the three values below and flip it to true — nothing else in
# the application changes.
DAM_ENABLED=false
DAM_BASE_URL=                     # e.g. https://dam.example.com/api/v1
DAM_API_KEY=                      # bearer token issued by the DAM
DAM_TIMEOUT_MS=8000
DAM_DEFAULT_FOLDER=               # optional; where uploads land when unspecified

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-access-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-local-refresh-secret-min-32-characters-long
JWT_REFRESH_TTL=30d
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2
# How long a single-use link stays valid. An invitation is a week because an
# administrator sends it and a person answers it on their own schedule; a
# password reset is an hour because the user is waiting for it right now.
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60

# --- Security --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
TRUST_PROXY=false
WEBHOOK_HMAC_SECRET=change-me-local-webhook-hmac-secret-min-32-chars
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Mail ------------------------------------------------------------------
MAIL_TRANSPORT=smtp               # smtp | sendgrid | postmark | console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM_ADDRESS=no-reply@ticketit.local
MAIL_FROM_NAME=Ticket-IT Portal

# --- Workers ---------------------------------------------------------------
WORKER_CONCURRENCY=5
RENDER_CONCURRENCY=2
RENDER_JOB_TIMEOUT_MS=120000
RENDER_BROWSER_POOL_SIZE=2

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug                   # trace | debug | info | warn | error | fatal
LOG_PRETTY=true                   # false in every deployed environment
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Feature flags ---------------------------------------------------------
SWAGGER_ENABLED=true              # forced off in production
FEATURE_ROLE_SWITCHER=true        # demo-only role switcher; forced off in production
FEATURE_MOCK_INTEGRATIONS=true    # use mock PrintFlow/3PL/ERP adapters
